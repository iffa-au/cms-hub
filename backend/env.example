# -------- Backend Environment Example --------
NODE_ENV=development
PORT=8000

# MongoDB connection
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# CORS
# Primary frontend origin
CLIENT_URL=http://localhost:3000
# Additional allowed origins (comma-separated), e.g. https://iffa.com.au,https://admin.iffa.com.au
ALLOWED_ORIGINS=

# JWT
JWT_ACCESS_SECRET=replace-with-strong-random-string
JWT_REFRESH_SECRET=replace-with-strong-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d

# Optional: Arcjet key for email validation
ARCJET_KEY=

# Mail (Mailchimp Transactional)
MAILCHIMP_TX_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=IFFA
MAILCHIMP_TO_IFFA_EMAIL=
MC_TEMPLATE_SLUG=SubmitFilm-Thankyou

# S3 uploads (submit-film form image uploads — presigned PUT)
# Same bucket that backs NEXT_PUBLIC_CLOUDFRONT_URL on the frontend.
# Credentials resolve via the AWS SDK's default provider chain (explicit
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars, or an attached IAM role
# in production) — no separate key/secret vars needed here.
AWS_REGION=
AWS_S3_BUCKET=
# Folder uploads are written under; safe to change later without a code
# change if this season's assets need to move to a new prefix.
AWS_S3_UPLOAD_PREFIX=submissions-2026
