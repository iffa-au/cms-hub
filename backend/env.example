# -------- Backend Environment Example --------
NODE_ENV=development
PORT=8000

# MongoDB connection
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# CORS
# Primary frontend origin
CLIENT_URL=http://localhost:3000
# Additional allowed origins (comma-separated), e.g. https://iffa.com.au,https://admin.iffa.com.au
ALLOWED_ORIGINS=

# JWT
JWT_ACCESS_SECRET=replace-with-strong-random-string
JWT_REFRESH_SECRET=replace-with-strong-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d

# Optional: Arcjet key for email validation
ARCJET_KEY=

# Mail (Mailchimp Transactional)
MAILCHIMP_TX_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=IFFA
MAILCHIMP_TO_IFFA_EMAIL=
MC_TEMPLATE_SLUG=SubmitFilm-Thankyou

# S3 uploads (submit-film form image uploads — presigned PUT)
# Same bucket that backs NEXT_PUBLIC_CLOUDFRONT_URL on the frontend.
# Credentials resolve via the AWS SDK's default provider chain (explicit
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars, or an attached IAM role
# in production) — no separate key/secret vars needed here.
AWS_REGION=
AWS_S3_BUCKET=
# Folder uploads are written under; safe to change later without a code
# change if this season's assets need to move to a new prefix.
AWS_S3_UPLOAD_PREFIX=submissions-2026
# Folder for partner logos uploaded from the CMS. Optional — defaults to a
# "partners" folder alongside AWS_S3_UPLOAD_PREFIX (so
# "iffa/images/submissions-2026" implies "iffa/images/partners"). Only set
# this if logos need to live somewhere unrelated to the submissions folder.
# AWS_S3_PARTNERS_PREFIX=
# Public CDN base URL that fronts the bucket above (same value as the
# website's NEXT_PUBLIC_CLOUDFRONT_URL). Used to hand the CMS a ready-to-store
# public URL after a partner logo upload. Required for partner logo uploads.
CLOUDFRONT_URL=

# Chatbot insights (iffa-2026's IFFA Assistant)
# Shared secret: iffa-2026's server sends it with every question it logs
# (POST /chatbot-questions). The same value must be set as CHATBOT_INSIGHTS_KEY
# on the website (Amplify). At least 20 characters; make one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Unset = the endpoint refuses everything (the chatbot keeps working, nothing is logged).
CHATBOT_INSIGHTS_KEY=
# How many days chatbot questions are kept before MongoDB deletes them
# automatically (7-365). Default 90. A change applies on the next backend start.
CHATBOT_RETENTION_DAYS=90
# Public site on-demand revalidation (iffa-2026 /api/revalidate). After a
# submission, nomination, winner or carousel change the backend pings the site
# so its cached event pages refresh immediately. Leave unset to disable.
# SITE_REVALIDATE_SECRET must equal the site's REVALIDATE_SECRET.
SITE_URL=https://iffa.com.au
SITE_REVALIDATE_SECRET=
